# Backend Environment Variables (Render / Local)

# Server Port (Render sets PORT automatically)
PORT=8080

# Neon Tech PostgreSQL Database Connection
# Neon provides a connection string like: postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_DRIVER=org.postgresql.Driver

# Security JWT Secret (Generate a strong 256-bit key for production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Seeding (Set to 'false' for production, 'true' if you want mock demo data)
QUIZ_SEED_ENABLED=false
